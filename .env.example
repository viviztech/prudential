# PostgreSQL connection for certificate and user records.
DATABASE_URL=postgres://user:password@host:5432/database

# Required only to create the first account in production if no legacy admin exists.
ADMIN_SETUP_TOKEN=replace-with-a-long-random-token

# Existing deployments with these values can sign in using their former admin password.
# After signing in, add individual users and remove these variables.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=old-admin-password
# AUTH_SECRET=old-auth-secret
